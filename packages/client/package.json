{
  "name": "@ooraini/pgquic",
  "version": "0.1.0",
  "description": "PostgreSQL client API for browsers over multiplexed WebTransport",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ooraini/pgquic.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/ooraini/pgquic#readme",
  "bugs": {
    "url": "https://github.com/ooraini/pgquic/issues"
  },
  "keywords": [
    "postgresql",
    "browser",
    "webtransport",
    "quic"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSES"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "licenses": "node scripts/generate-licenses.mjs",
    "prepack": "npm run build && npm run licenses",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings 0"
  },
  "devDependencies": {
    "buffer": "6.0.3",
    "events": "3.3.0",
    "pg": "8.23.0",
    "pg-pool": "3.14.0",
    "@types/node": "24.3.1",
    "@types/pg": "8.15.5",
    "@typescript-eslint/eslint-plugin": "8.43.0",
    "@typescript-eslint/parser": "8.43.0",
    "eslint": "9.35.0",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
